    },
    {
     "_type": "span",
     "_key": "4bcca04c46c8",
     "text": " Most Fantasyland dark rides and spinners, \"it's a small world,\" Jungle Cruise, Pirates, PeopleMover, and many shows have no height requirement (the railroad does too, once it reopens). See them in the ",
     "marks": []
    },
    {
     "_type": "span",
     "_key": "fbb5ef5e29e1",
     "text": "under-40 ride finder",
     "marks": [
      "1c0e7d76f9ca"
     ]
    },
    {
     "_type": "span",
     "_key": "5f9bb67db35f",
     "text": ".",
     "marks": []
    }
   ]
  },
  {
   "_type": "block",
   "_key": "c3a7b242dbc6",
   "style": "normal",
   "markDefs": [],
   "children": [
    {
     "_type": "span",
     "_key": "aea9f9f9b376",
     "text": "Is Big Thunder Mountain 38 or 40 inches?",
     "marks": [
      "strong"
     ]
    },
    {
     "_type": "span",
     "_key": "56534b04c72b",
     "text": " Disney's official Big Thunder Mountain Railroad page lists ",
     "marks": []
    },
