   "children": [
    {
     "_type": "span",
     "_key": "fd2787da374a",
     "text": "What rides at Magic Kingdom have height requirements?",
     "marks": [
      "strong"
     ]
    },
    {
     "_type": "span",
     "_key": "f61697bc4a3d",
     "text": " The main ones are Tomorrowland Speedway (32\" with a 54\" companion; 54\" alone), The Barnstormer (35\"), Seven Dwarfs Mine Train and Big Thunder Mountain Railroad (38\"), Tiana's Bayou Adventure (40\"), Space Mountain (44\"), and TRON Lightcycle / Run (48\"), per Disney's official pages (accessed Oct 19, 2026).",
     "marks": []
    }
   ]
  },
  {
   "_type": "block",
   "_key": "e1bb5123bf9e",
   "style": "normal",
   "markDefs": [
    {
     "_type": "link",
     "_key": "1c0e7d76f9ca",
     "href": "/rides/for/magic-kingdom-under-40/"
    }
   ],
   "children": [
    {
     "_type": "span",
     "_key": "09218e8217bd",
     "text": "What can a 3-year-old do at Magic Kingdom?",
     "marks": [
      "strong"
