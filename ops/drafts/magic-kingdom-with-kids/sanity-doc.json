   "children": [
    {
     "_type": "span",
     "_key": "b6ddac1515a1",
     "text": "Magic Kingdom is large, outdoor-heavy, and often crowded. Plan water and shade breaks, and use indoor attractions to cool off. If a child shows signs of heat illness, get help from park First Aid or a doctor. Disney lists ",
     "marks": []
    },
    {
     "_type": "span",
     "_key": "7e0be4a1d0a0",
     "text": "First Aid centers",
     "marks": [
      "0402c5d492f2"
     ]
    },
    {
     "_type": "span",
     "_key": "b3e74d19d8d8",
     "text": " in its theme parks.",
