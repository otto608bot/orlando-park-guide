  {
   "_type": "block",
   "_key": "f10bf81e5d11",
   "style": "normal",
   "markDefs": [
    {
     "_type": "link",
     "_key": "268a68e3dd26",
     "href": "/deals/"
    }
   ],
   "children": [
    {
     "_type": "span",
     "_key": "0572b0756ee0",
     "text": "Animal Kingdom is included with standard Disney World park tickets. Disney counts children ages 3–9 at child pricing, and children under 3 do not need a ticket. Compare current ticket options on our ",
     "marks": []
    },
    {
     "_type": "span",
     "_key": "f2f57b8ceb3e",
     "text": "Disney World deals page",
     "marks": [
      "268a68e3dd26"
