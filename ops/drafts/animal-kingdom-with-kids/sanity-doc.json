    {
     "_type": "span",
     "_key": "2b4e225b5fd1",
     "text": "Source: official Walt Disney World attraction pages, accessed October 16, 2026. See the ",
     "marks": []
    },
    {
     "_type": "span",
     "_key": "1b1d73fb231e",
     "text": "44-inch Animal Kingdom list",
     "marks": [
      "ae82a616f2fd"
     ]
    },
    {
     "_type": "span",
     "_key": "b1bb550a98b4",
     "text": " and the ",
     "marks": []
    },
    {
     "_type": "span",
