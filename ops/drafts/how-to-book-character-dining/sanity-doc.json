   "style": "normal",
   "markDefs": [],
   "children": [
    {
     "_type": "span",
     "_key": "ccb5fc0d707d",
     "text": "Book the hardest one first.",
     "marks": [
      "strong"
     ]
    },
    {
     "_type": "span",
     "_key": "ebd0a1cd3340",
     "text": " If Cinderella's Royal Table is on your list, start there, then move to the rest.",
     "marks": []
    }
