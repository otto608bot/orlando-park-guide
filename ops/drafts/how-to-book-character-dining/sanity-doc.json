     "text": "November 2, 2026",
     "marks": [
      "strong"
     ]
    },
    {
     "_type": "span",
     "_key": "c12e5ea96c2a",
     "text": ". Disney says its policies can change without notice, so re-check before you book. Still picking a restaurant? Start with our ",
     "marks": []
    },
    {
     "_type": "span",
     "_key": "6306326edbbb",
