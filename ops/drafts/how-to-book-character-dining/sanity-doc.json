   "children": [
    {
     "_type": "span",
     "_key": "ac1a8e52270d",
     "text": "Heads-up notes from Disney's pages:",
     "marks": [
      "strong"
     ]
    },
    {
     "_type": "span",
     "_key": "7592c01f81a7",
     "text": " Grand Floridian renovations continue in select areas through early 2027, so you may see work or need to take a different path to 1900 Park Fare. ʻOhana's page says exterior maintenance may block some lagoon views. The Disney Skyliner is scheduled to close for refurbishment January 24 to 30, 2027, with buses provided, which matters if you plan to reach Topolino's Terrace by Skyliner that week.",
     "marks": []
    }
   ]
  },
  {
   "_type": "block",
   "_key": "87a41c5fd617",
   "style": "h2",
   "markDefs": [],
   "children": [
    {
     "_type": "span",
     "_key": "6194dee5d07c",
     "text": "A Simple Booking-Morning Plan",
     "marks": []
    }
   ]
  },
  {
   "_type": "block",
   "_key": "bda790e5c9eb",
   "style": "normal",
   "markDefs": [],
   "children": [
    {
     "_type": "span",
     "_key": "b997481fde8c",
     "text": "Pick your top two meals per date.",
     "marks": [
      "strong"
     ]
    },
    {
     "_type": "span",
     "_key": "ee0f28c62391",
     "text": " Have a backup restaurant and a backup meal (breakfast or lunch) ready. Breakfast is often the lower price tier on Disney's pages, so it makes a good backup.",
     "marks": []
    }
   ],
   "listItem": "number",
   "level": 1
  },
