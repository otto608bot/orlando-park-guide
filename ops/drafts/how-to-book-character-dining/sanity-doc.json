   "style": "normal",
   "markDefs": [],
   "children": [
    {
     "_type": "span",
     "_key": "7913e5b3ba5a",
     "text": "Sign in the night before.",
     "marks": [
      "strong"
     ]
    },
    {
     "_type": "span",
     "_key": "0c0f46f07c6c",
     "text": " Make sure your Disney account works and your party is set up, including kids and babies.",
     "marks": []
    }
