   ],
   "children": [
    {
     "_type": "span",
     "_key": "11f0d9cae129",
     "text": "What can a 4-year-old do at EPCOT?",
     "marks": [
      "strong"
     ]
    },
    {
     "_type": "span",
     "_key": "54d20786f0d8",
     "text": " Frozen Ever After, Remy's Ratatouille Adventure, The Seas with Nemo & Friends, Turtle Talk with Crush, Figment, Spaceship Earth, Journey of Water and ImageWorks all have no height requirement. See all of them in the ",
     "marks": []
    },
    {
     "_type": "span",
     "_key": "daadef0596a2",
     "text": "ride finder",
     "marks": [
      "205f074fe680"
     ]
    },
    {
     "_type": "span",
     "_key": "905ec1eea4a0",
     "text": ".",
     "marks": []
    }
   ]
  },
  {
   "_type": "block",
   "_key": "4229f3ceb586",
   "style": "normal",
   "markDefs": [],
   "children": [
    {
     "_type": "span",
     "_key": "b6cc805b59af",
     "text": "How many rides are at EPCOT?",
     "marks": [
      "strong"
     ]
    },
    {
     "_type": "span",
     "_key": "40d04470b0c2",
     "text": " This guide counts 11 rides operating as of October 26, 2026 (with Mission: SPACE counted once), plus shows, films, walk-through trails and play areas. Living with the Land is scheduled closed November 27 to December 30, 2026. Our ride finder lists EPCOT rides with heights.",
     "marks": []
    }
   ]
  }
