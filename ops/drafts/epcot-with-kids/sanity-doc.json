    },
    {
     "_type": "span",
     "_key": "aecb77519758",
     "text": " 40 inches (102 cm) for Soarin' Across America, the film currently showing.",
     "marks": []
    }
   ]
  },
  {
   "_type": "block",
   "_key": "fc1f9e86e4dc",
   "style": "normal",
   "markDefs": [],
   "children": [
    {
     "_type": "span",
     "_key": "6523c1ed35b9",
     "text": "What is the height requirement for Mission: SPACE?",
