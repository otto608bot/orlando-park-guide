  },
  {
   "_type": "block",
   "_key": "77450853aee7",
   "style": "h2",
   "markDefs": [],
   "children": [
    {
     "_type": "span",
     "_key": "4afde46a117d",
     "text": "Is EPCOT Good for Kids?",
     "marks": []
    }
   ]
  },
  {
   "_type": "block",
   "_key": "46ff8998aa65",
   "style": "normal",
   "markDefs": [],
   "children": [
    {
     "_type": "span",
     "_key": "c5e0f1800496",
     "text": "Yes — more than its reputation suggests. EPCOT has a big list of attractions with no height requirement, including Frozen Ever After, Remy's Ratatouille Adventure, The Seas with Nemo & Friends and a hands-on water trail inspired by Moana. Only four rides have a height minimum, and the tallest is 44 inches. The trade-off is walking: World Showcase is a long loop, so pace the day around breaks.",
     "marks": []
    }
   ]
  },
  {
   "_type": "block",
   "_key": "778c9632ea9c",
   "style": "normal",
   "markDefs": [
    {
     "_type": "link",
     "_key": "292816f599f0",
     "href": "/rides/for/epcot-under-40/"
    }
   ],
   "children": [
    {
     "_type": "span",
     "_key": "1212cbad1dc8",
     "text": "Below, every current EPCOT ride and major kid attraction is sorted by the official minimum height on Disney's attraction pages (checked October 26, 2026). Rules can change, so re-check close to your trip. Want the list filtered for you? Open ",
     "marks": []
    },
    {
     "_type": "span",
     "_key": "d75985bfa3c9",
     "text": "EPCOT rides for kids under 40 inches",
     "marks": [
      "292816f599f0"
     ]
    },
    {
     "_type": "span",
     "_key": "641154f85de6",
     "text": " in the ride finder.",
     "marks": []
    }
   ]
  },
  {
   "_type": "block",
   "_key": "bcb04d77d3be",
   "style": "h2",
   "markDefs": [],
   "children": [
    {
     "_type": "span",
     "_key": "98d60225acc7",
     "text": "EPCOT Ride Heights at a Glance",
     "marks": []
    }
   ]
  },
  {
   "_type": "block",
   "_key": "76acc8352d5f",
   "style": "normal",
   "markDefs": [],
   "children": [
    {
     "_type": "span",
     "_key": "c3d0da437514",
     "text": "Any height:",
     "marks": [
      "strong"
     ]
    },
    {
     "_type": "span",
     "_key": "24009de1b772",
     "text": " Frozen Ever After, Remy's Ratatouille Adventure, Spaceship Earth, The Seas with Nemo & Friends, Turtle Talk with Crush, Journey Into Imagination with Figment, Gran Fiesta Tour Starring The Three Caballeros, Living with the Land (see the holiday closure note below), Journey of Water Inspired by Moana, Disney and Pixar Short Film Festival, Awesome Planet, Canada Far and Wide, Beauty and the Beast Sing-Along",
     "marks": []
    }
   ],
   "listItem": "bullet",
   "level": 1
  },
  {
   "_type": "block",
   "_key": "01fb27ed84d4",
   "style": "normal",
   "markDefs": [],
   "children": [
    {
     "_type": "span",
     "_key": "94ebfee20137",
     "text": "40 inches (102 cm):",
     "marks": [
      "strong"
     ]
    },
    {
     "_type": "span",
     "_key": "c0b8c518dc07",
     "text": " Test Track, Soarin' Across America, Mission: SPACE (Green, the gentler orbit version)",
     "marks": []
    }
   ],
   "listItem": "bullet",
   "level": 1
  },
  {
   "_type": "block",
   "_key": "ff38273ec90c",
   "style": "normal",
   "markDefs": [],
   "children": [
    {
     "_type": "span",
     "_key": "dd8837fe6e78",
     "text": "42 inches (107 cm):",
     "marks": [
      "strong"
     ]
    },
    {
     "_type": "span",
     "_key": "72b4055acca1",
     "text": " Guardians of the Galaxy: Cosmic Rewind",
     "marks": []
    }
   ],
   "listItem": "bullet",
   "level": 1
  },
  {
   "_type": "block",
   "_key": "3e1015d0879b",
   "style": "normal",
   "markDefs": [],
   "children": [
    {
     "_type": "span",
     "_key": "0d8e5de32ca1",
     "text": "44 inches (112 cm):",
     "marks": [
      "strong"
     ]
    },
    {
     "_type": "span",
     "_key": "7c9f76727279",
     "text": " Mission: SPACE (Orange, the more intense Mars version)",
     "marks": []
    }
   ],
   "listItem": "bullet",
   "level": 1
  },
  {
   "_type": "block",
   "_key": "27db437f3270",
   "style": "normal",
   "markDefs": [
