  },
  {
   "_type": "block",
   "_key": "a1305a400984",
   "style": "normal",
   "markDefs": [],
   "children": [
    {
     "_type": "span",
     "_key": "bec655bd14ec",
     "text": "What is the height requirement for Guardians of the Galaxy: Cosmic Rewind?",
     "marks": [
      "strong"
     ]
    },
    {
     "_type": "span",
     "_key": "32e308bce50c",
     "text": " 42 inches (107 cm), per Disney's official attraction page (accessed Oct 26, 2026).",
     "marks": []
    }
   ]
  },
  {
   "_type": "block",
   "_key": "a200d6f349df",
   "style": "normal",
   "markDefs": [],
   "children": [
    {
     "_type": "span",
     "_key": "c650399f71c6",
     "text": "What is the height requirement for Test Track?",
     "marks": [
      "strong"
     ]
    },
    {
     "_type": "span",
     "_key": "51418e7986b2",
     "text": " 40 inches (102 cm).",
     "marks": []
    }
   ]
  },
  {
   "_type": "block",
   "_key": "b51ca4de5338",
   "style": "normal",
   "markDefs": [],
   "children": [
    {
     "_type": "span",
     "_key": "531c4d88e327",
     "text": "What is the height requirement for Soarin'?",
     "marks": [
      "strong"
