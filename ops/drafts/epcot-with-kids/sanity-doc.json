   ],
   "children": [
    {
     "_type": "span",
     "_key": "8bc3967d6e97",
     "text": "EPCOT is included with standard Disney World park tickets, and Disney says the Food & Wine Festival is included with valid EPCOT admission. Check Disney's official ticket page for current child ticket ages and prices before you buy. Compare current ticket options on our ",
     "marks": []
    },
    {
     "_type": "span",
     "_key": "7ece6d20d932",
     "text": "Disney World deals page",
     "marks": [
      "6afa1527b324"
