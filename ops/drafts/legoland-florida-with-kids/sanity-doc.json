    }
   ]
  },
  {
   "_type": "block",
   "_key": "a37703bb4e62",
   "style": "normal",
   "markDefs": [],
   "children": [
    {
     "_type": "span",
     "_key": "230d958e588c",
     "text": "Mia's Riding Adventure (48 inches):",
     "marks": [
      "strong"
     ]
    },
    {
     "_type": "span",
     "_key": "d35bd1fe8735",
     "text": " a disc coaster in Heartlake City. For most families, this is the park's biggest thrill.",
     "marks": []
    }
   ],
   "listItem": "bullet",
   "level": 1
  },
  {
   "_type": "block",
   "_key": "38354c7babb6",
   "style": "normal",
   "markDefs": [],
   "children": [
    {
     "_type": "span",
     "_key": "c5715ddb106b",
     "text": "AQUAZONE Wave Racers (52 inches):",
     "marks": [
      "strong"
     ]
    },
    {
     "_type": "span",
     "_key": "31e19e224c35",
     "text": " you race through the waves in LEGO Technic vehicles and dodge water blasts. LEGOLAND lists a 52-inch minimum but also says riders 40 to 52 inches must ride with someone 14 or older in the same vehicle. That wording is unclear, so ask the ride host before you queue with a shorter child.",
     "marks": []
    }
   ],
   "listItem": "bullet",
   "level": 1
  },
  {
   "_type": "block",
   "_key": "e6ff83b58f30",
   "style": "normal",
   "markDefs": [
    {
     "_type": "link",
     "_key": "cf2da48e798d",
