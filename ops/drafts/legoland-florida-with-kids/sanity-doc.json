   "children": [
    {
     "_type": "span",
     "_key": "08090c8821d9",
     "text": "The Great LEGO Race (42 inches):",
     "marks": [
      "strong"
     ]
    },
    {
     "_type": "span",
     "_key": "0d1891c85423",
     "text": " a road-rally themed coaster. Riders 42 to 47 inches ride with someone 14 or older and 48 inches tall; 48 inches and up can ride alone.",
