     "href": "/rides/for/legoland-52/"
    }
   ],
   "children": [
    {
     "_type": "span",
     "_key": "4b9725a8ace9",
     "text": "Compare with the ",
     "marks": []
    },
    {
     "_type": "span",
     "_key": "1a2f64bcb5d3",
