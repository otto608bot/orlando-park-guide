   "children": [
    {
     "_type": "span",
     "_key": "aac3e05a9872",
     "text": "THE LEGO MOVIE Masters of Flight (40 inches):",
     "marks": [
      "strong"
     ]
    },
    {
     "_type": "span",
     "_key": "6ea771af6e6b",
     "text": " an indoor flying-theater ride. Riders 40 to 52 inches must sit next to a companion who is 14 or older and 52 inches tall.",
     "marks": []
    }
   ],
   "listItem": "bullet",
   "level": 1
  },
  {
   "_type": "block",
