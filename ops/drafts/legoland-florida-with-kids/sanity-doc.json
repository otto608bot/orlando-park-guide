   "children": [
    {
     "_type": "span",
     "_key": "06cdee7cb425",
     "text": "Technicycle (36 inches):",
     "marks": [
      "strong"
     ]
    },
    {
     "_type": "span",
     "_key": "95814c03386b",
     "text": " pedal-powered cars that rise as you pedal faster. Riders 36 to 48 inches go with someone 14 or older. Closed November 2 to 20.",
     "marks": []
    }
   ],
   "listItem": "bullet",
   "level": 1
  },
  {
   "_type": "block",
   "_key": "7bd025e95f60",
   "style": "normal",
   "markDefs": [],
   "children": [
    {
     "_type": "span",
     "_key": "9c5e9af1d528",
     "text": "One to check at the ride: ",
     "marks": []
    },
    {
     "_type": "span",
     "_key": "e913ab60ef18",
     "text": "Kid Power Towers",
     "marks": [
      "strong"
     ]
    },
    {
     "_type": "span",
     "_key": "65e78569cdd0",
     "text": ", where kids pull themselves up a tower and drop back down. LEGOLAND's height chart lists ",
     "marks": []
    },
    {
     "_type": "span",
     "_key": "3c63bde676bf",
     "text": "30 inches",
     "marks": [
      "strong"
     ]
    },
    {
     "_type": "span",
     "_key": "8d17b7ca025b",
     "text": ", but the ride's own page says ",
     "marks": []
    },
    {
     "_type": "span",
     "_key": "515b8e6086ea",
     "text": "38 inches",
     "marks": [
      "strong"
     ]
    },
    {
     "_type": "span",
     "_key": "30cbbba242ff",
     "text": ", with riders under 48 inches going with someone 14 or older. Plan on 38 inches to avoid a disappointed kid.",
     "marks": []
    }
   ]
  },
