b4fa8a4","_type":"link","href":"https://disneyworld.disney.go.com/dining/riviera-resort/topolinos-terrace/"}],"style":"normal"},{"_key":"9d017f91dd15","_type":"block","children":[{"_key":"7ae2bd894d60","_type":"span","marks":["1d65d73cef5b"],"text":"Cape May Cafe"},{"_key":"88b89b2ba9bf","_type":"span","marks":[],"text":" (Beach Club Resort): Minnie's Beach Bash Breakfast; no characters at dinner"}],"level":1,"listItem":"bullet","markDefs":[{"_key":"1d65d73cef5b","_type":"link","href":"https://disneyworld.disney.go.com/dining/beach-club-resort/cape-may-cafe/"}],"style":"normal"},{"_key":"4e0d5d582fd2","_type":"block","children":[{"_key":"719cd6103160","_type":"span","marks":["4fd7be7ed65b"],"text":"Story Book Dining at Artist Point"},{"_key":"c390ddef7cd9","_type":"span","marks":[],"text":" (Wilderness Lodge): dinner only"}],"level":1,"listItem":"bullet","markDefs":[{"_key":"4fd7be7ed65b","_type":"link","href":"https://disneyworld.disney.go.com/dining/wilderness-lodge-resort/artist-point/"}],"style":"normal"},{"_key":"997b60e147e7","_type":"block","children":[{"_key":"6e70f72b61ba","_type":"span","marks":[],"text":"A non-park day with a resort character breakfast is an easy way to give kids character time without buying another park day."}],"markDefs":[],"style":"normal"},{"_key":"2451d1fadd6d","_type":"block","children":[{"_key":"28594e717117","_type":"span","marks":[],"text":"How to Book Disney Character Dining"}],"markDefs":[],"style":"h2"},{"_key":"6de50e10796e","_type":"block","children":[{"_key":"d0b528588f00","_type":"span","marks":["strong"],"text":"When:"},{"_key":"9c3b72329773","_type":"span","marks":[],"text":" Disney dining reservations open 60 days ahead at 6:00 AM Eastern ("},{"_key":"24a5d851acf0","_type":"span","marks":["0a8199b33bcd"],"text":"planDisney, Oct 13, 2026"},{"_key":"d993c00ba537","_type":"span","marks":[],"text":")."}],"level":1,"listItem":"bullet","markDefs":[{"_key":"0a8199b33bcd","_type":"link","href":"https://plandisney.disney.go.com/question/book-dining-reservation-cinderellas-castle-day-advance-646572/"}],"style":"normal"},{"_key":"7fb951142eb6","_type":"block","children":[{"_key":"6359e5710d31","_type":"span","marks":["strong"],"text":"Disney hotel guests"},{"_key":"b2277a0f6cf5","_type":"span","marks":[],"text":" can book their whole stay, up to 10 days, at the 60-day mark. Everyone else books one day at a time."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"9edee9242ae8","_type":"block","children":[{"_key":"c805160bfcc0","_type":"span","marks":["strong"],"text":"No hotel or tickets needed to book"},{"_key":"6b2ea58f09c7","_type":"span","marks":[],"text":", per the same planDisney answer. You still need park admission on the day for in-park restaurants."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"7318aebe5b54","_type":"block","children":[{"_key":"961e8cdb5f29","_type":"span","marks":["strong"],"text":"Cancellation:"},{"_key":"d31c3c201863","_type":"span","marks":[],"text":" restaurants charge a per-person fee if you don't cancel in time. At "},{"_key":"4c8618365fc9","_type":"span","marks":["d2b1cfe3d27e"],"text":"Cinderella's Royal Table"},{"_key":"cb83424606a5","_type":"span","marks":[],"text":" you pay in full when you book, you can't modify the reservation, and you must cancel at least 2 hours ahead or the full price is charged."}],"level":1,"listItem":"bullet","markDefs":[{"_key":"d2b1cfe3d27e","_type":"link","href":"https://disneyworld.disney.go.com/dining/magic-kingdom/cinderella-royal-table/"}],"style":"normal"},{"_key":"7ff117491062","_type":"block","children":[{"_key":"0d1279638371","_type":"span","marks":[],"text":"If you're still sorting out tickets, compare options on our "},{"_key":"a0fafa3c5d3b","_type":"span","marks":["1395f2df5d85"],"text":"ticket deals page"},{"_key":"22bc817850eb","_type":"span","marks":[],"text":" before your 60-day window opens."}],"markDefs":[{"_key":"1395f2df5d85","_type":"link","href":"/deals/"}],"style":"normal"},{"_key":"51b18d277dd3","_type":"block","children":[{"_key":"6afa6f15a028","_type":"span","marks":[],"text":"Character Dining FAQ"}],"markDefs":[],"style":"h2"},{"_key":"7b304bf2d94d","_type":"block","children":[{"_key":"7d39d22cd314","_type":"span","marks":[],"text":"Is Disney character dining worth it with kids?"}],"markDefs":[],"style":"h3"},{"_key":"b8137a056d89","_type":"block","children":[{"_key":"96fa5d0f0ab6","_type":"span","marks":[],"text":"It's worth it for kids who are excited to meet characters, because the characters come to you while you eat. If your kids are nervous around costumed characters, or you're on a tight budget, starting with one character breakfast keeps the cost down."}],"markDefs":[],"style":"normal"},{"_key":"6905d118c4c1","_type":"block","children":[{"_key":"fc3ca99a9ead","_type":"span","marks":[],"text":"When should I book Disney World character dining?"}],"markDefs":[],"style":"h3"},{"_key":"138acf21ad44","_type":"block","children":[{"_key":"54f38be7c377","_type":"span","marks":[],"text":"At 60 days out, at 6:00 AM Eastern. Popular meals can fill quickly, so be ready when your window opens."}],"markDefs":[],"style":"normal"},{"_key":"36becc6bfcd8","_type":"block","children":[{"_key":"7f8493d8935b","_type":"span","marks":[],"text":"How much is character dining at Disney World?"}],"markDefs":[],"style":"h3"},{"_key":"ba7b6d57dc30","_type":"block","children":[{"_key":"cf2753f2e4c6","_type":"span","marks":[],"text":"On Disney's official pages (Oct 26, 2026), character breakfasts are mostly in the $35 to $59.99 per adult tier, and lunch and dinner are mostly over $60 per adult. Cinderella's Royal Table, 1900 Park Fare, and Story Book Dining are over $60 at every meal they serve."}],"markDefs":[],"style":"normal"},{"_key":"02710ab8309c","_type":"block","children":[{"_key":"0b777ca03f8a","_type":"span","marks":[],"text":"Which Disney character dining is best for toddlers?"}],"markDefs":[],"style":"h3"},{"_key":"6e0e3536e73c","_type":"block","children":[{"_key":"5fc768b7918f","_type":"span","marks":[],"text":"Buffet or family-style meals with familiar characters are the easiest picks: The Crystal Palace (Winnie the Pooh), Chef Mickey's (Mickey Mouse), and ʻOhana breakfast (Lilo and Stitch)."}],"markDefs":[],"style":"normal"},{"_key":"289931826e6c","_type":"block","children":[{"_key":"8adde98a3075","_type":"span","marks":[],"text":"Can you do character dining without a park ticket?"}],"markDefs":[],"style":"h3"},{"_key":"2e5f3a7a0be5","_type":"block","children":[{"_key":"c117ef482d3e","_type":"span","marks":[],"text":"Yes. Resort hotel meals like Chef Mickey's, ʻOhana breakfast, 1900 Park Fare, Topolino's Terrace breakfast, Cape May Cafe breakfast, and Story Book Dining don't list a park admission requirement on Disney's pages."}],"markDefs":[],"style":"normal"},{"_key":"fe633e78921e","_type":"block","children":[{"_key":"1907ed01f8be","_type":"span","marks":[],"text":"Do characters appear at every meal?"}],"markDefs":[],"style":"h3"},{"_key":"8dcde1eefa32","_type":"block","children":[{"_key":"c2e79ffa4e28","_type":"span","marks":[],"text":"No. At ʻOhana, Topolino's Terrace, and Cape May Cafe, characters appear at breakfast only, and Story Book Dining is dinner only. Check the meal period on the "},{"_key":"075f1ef670ca","_type":"span","marks":["43a352f6354b"],"text":"character dining list"},{"_key":"881fe5cecbeb","_type":"span","marks":[],"text":" before you book."}],"markDefs":[{"_key":"43a352f6354b","_type":"link","href":"/character-dining/"}],"style":"normal"}],"categories":[{"_key":"4a4e23d818c5","_ref":"q5bQv6QFqWcAZeLNacathw","_type":"reference"}],"excerpt":"Which Disney World character meals fit your kids, what each costs per adult (Disney's official price tiers, Oct 2026), and how to book at 60 days. Picks by age and park day.","heroImage":{"_type":"image","alt":"Kids laughing as a big friendly costumed bear hugs them and a princess-style character in a coral gown waves at a sunny resort breakfast table","asset":{"_ref":"image-e1845d6a0846c0be8e1c3976279023bb83141305-1376x768-jpg","_type":"reference"}},"readTime":6,"slug":{"_type":"slug","current":"best-disney-world-character-dining-kids"},"tags":["Disney World character dining","character breakfast","Disney dining with kids","Disney World"],"title":"Best Disney World Character Dining for Kids (2026): Prices, Ages, and How to Book"}],"syncTags":["s1:QQcvhg","s1:lmCadw"],"ms":15}